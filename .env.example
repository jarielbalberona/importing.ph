# Clerk authentication (required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/after-auth
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/after-auth

# PostgreSQL (required)
DATABASE_URL=postgresql://importing_ph:importing_ph_password@localhost:5032/importing_ph_dev

# Application secrets (required; use independent random values)
RATE_LIMIT_HASH_SECRET=replace_with_a_random_secret
REALTIME_TOKEN_SECRET=replace_with_a_different_random_secret

# Private Cloudflare R2 storage (required for attachments)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=importing-ph-private-dev

# Transactional email (required for email notifications)
RESEND_API_KEY=re_xxx
EMAIL_FROM="importing.ph <notifications@importing.ph>"

# Optional database tuning; application defaults shown
DATABASE_POOL_MAX=5
REALTIME_DATABASE_POOL_MAX=2
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_IDLE_TIMEOUT_SECONDS=20
